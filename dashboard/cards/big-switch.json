{
  "id": "big-switch",
  "name": "Big switch",
  "version": "1.0.0",
  "author": "Skypane (example)",
  "description": "One big round button for a light or a switch, glowing when it's on. A template card: no code of its own.",
  "tier": "template",
  "size": {"w": 2, "h": 2},
  "slots": [{"key": "dev", "label": "Light or switch", "attributes": ["switch", "level"], "commands": ["on", "off"]}],
  "settings": [{"key": "label", "label": "Label", "type": "text", "default": "Lights"}],
  "html": "<div class=\"wrap\"><button class=\"orb\" data-on=\"dev.switch=on\" data-if=\"dev.switch!=on\" data-cmd=\"dev:on\"><svg viewBox=\"0 0 24 24\" width=\"48\" height=\"48\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><path d=\"M12 3v9\"/><path d=\"M6.3 6.3a8 8 0 1 0 11.4 0\"/></svg></button><button class=\"orb on\" data-if=\"dev.switch=on\" data-cmd=\"dev:off\"><svg viewBox=\"0 0 24 24\" width=\"48\" height=\"48\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><path d=\"M12 3v9\"/><path d=\"M6.3 6.3a8 8 0 1 0 11.4 0\"/></svg></button><span>{{set.label}}</span></div>",
  "css": ".wrap{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px}.orb{width:96px;height:96px;border-radius:50%;border:2px solid rgba(255,255,255,.2);background:rgba(255,255,255,.06);color:var(--text,#fff)}.orb.on{background:var(--accent,#8b5cf6);border-color:var(--accent-2,#a78bfa);box-shadow:0 0 0 6px rgba(139,92,246,.25)}span{font-size:18px;font-weight:600}"
}
